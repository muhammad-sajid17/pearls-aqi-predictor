# Copy this to .env (and `pip install python-dotenv` + load it, or just
# `export` these) — or set them as GitHub Actions repo Variables/Secrets.

CITY_NAME=Rawalpindi
LATITUDE=33.6007
LONGITUDE=73.0679
TIMEZONE=auto

# Optional — leave blank to use the local parquet/joblib fallback store.
# Get a free key at https://app.hopsworks.ai
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=aqi_predictor
