.uv/

# --- Environment / secrets ---
.env
.env.local
*.pem
*.key

# --- Project data & model artifacts (regenerated by the pipelines) ---
# Keep the folders in git via .gitkeep, but not their generated contents.
data/*.parquet
models/*.joblib
models/*.json
models/leaderboard.csv
reports/*.png

# --- Streamlit ---
.streamlit/secrets.toml
.streamlit/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Editor / IDE ---
.vscode/
.idea/
*.swp

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Coverage / test artifacts ---
.coverage
htmlcov/